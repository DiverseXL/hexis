{
  "name": "@hexis/cli",
  "version": "0.1.0",
  "description": "Human-readable CLI for @hexis/core: discover, risk-check, copy, positions, history.",
  "type": "module",
  "bin": {
    "hexis": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "strike",
    "copy-trading",
    "cli",
